# No secret environment variables are required to run this application.
# All storefront, account, and Store Studio features run standalone with local browser storage.

# Optional real-user Web Vitals performance monitoring overrides (not required to run the site).
# Leave unset to use same-origin /api/vitals with no external collector required.
# VITE_WEB_VITALS_ENDPOINT=/api/vitals
# WEB_VITALS_FORWARD_URL=
# WEB_VITALS_FORWARD_TOKEN=
# WEB_VITALS_STORE_PATH=.data/web-vitals.ndjson